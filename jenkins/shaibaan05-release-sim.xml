<?xml version="1.1" encoding="UTF-8"?>
<project>
  <actions/>
  <description>05Shaibaan | Stage 3: Release rehearsal. Parameterized simulation only; successful calculator builds use defaults.</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <jenkins.model.BuildDiscarderProperty>
      <strategy class="hudson.tasks.LogRotator">
        <daysToKeep>-1</daysToKeep>
        <numToKeep>10</numToKeep>
        <artifactDaysToKeep>-1</artifactDaysToKeep>
        <artifactNumToKeep>10</artifactNumToKeep>
        <removeLastBuild>false</removeLastBuild>
      </strategy>
    </jenkins.model.BuildDiscarderProperty>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.ChoiceParameterDefinition>
          <name>TARGET_ENV</name>
          <description>Release slot</description>
          <choices class="java.util.Arrays$ArrayList">
            <a class="string-array">
              <string>dev</string>
              <string>staging</string>
              <string>prod</string>
            </a>
          </choices>
        </hudson.model.ChoiceParameterDefinition>
        <hudson.model.BooleanParameterDefinition>
          <name>RUN_SMOKE_TESTS</name>
          <description>Exercise simulated endpoint checks</description>
          <defaultValue>true</defaultValue>
        </hudson.model.BooleanParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>RELEASE_VERSION</name>
          <description>Calculator release identifier</description>
          <defaultValue>1.1.0</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
  </properties>
  <scm class="hudson.scm.NullSCM"/>
  <canRoam>true</canRoam>
  <disabled>false</disabled>
  <blockBuildWhenDownstreamBuilding>false</blockBuildWhenDownstreamBuilding>
  <blockBuildWhenUpstreamBuilding>false</blockBuildWhenUpstreamBuilding>
  <triggers/>
  <concurrentBuild>false</concurrentBuild>
  <builders>
    <hudson.tasks.Shell>
      <command>#!/bin/sh
set -eu
case &quot;$TARGET_ENV&quot; in dev|staging|prod) ;; *) echo &apos;Unsupported target environment&apos; &gt;&amp;2; exit 2;; esac
printf &apos;\n[05Shaibaan release simulation]\n&apos;
printf &apos;Release: %s | Target: %s | Smoke checks: %s\n&apos; &quot;$RELEASE_VERSION&quot; &quot;$TARGET_ENV&quot; &quot;$RUN_SMOKE_TESTS&quot;
if [ &quot;$TARGET_ENV&quot; = prod ]; then echo &apos;Production safety banner: simulation only.&apos;; fi
echo &quot;Preparing the $TARGET_ENV release slot (no remote changes)...&quot;
sleep 1
echo &quot;Release $RELEASE_VERSION staged in $TARGET_ENV (simulation).&quot;
if [ &quot;$RUN_SMOKE_TESTS&quot; = true ]; then
  echo &apos;Smoke checks: signed addition and subtraction endpoints (simulated).&apos;
  sleep 1
  echo &apos;Smoke checks: PASS (simulation).&apos;
else
  echo &apos;Smoke checks: skipped by parameter.&apos;
fi
echo &apos;Release simulation completed.&apos;
</command>
      <configuredLocalRules/>
    </hudson.tasks.Shell>
  </builders>
  <publishers/>
  <buildWrappers/>
</project>