<?xml version="1.1" encoding="UTF-8"?>
<project>
  <actions/>
  <description>05Shaibaan | Stage 1: Welcome and execution identity. Independent runs; shared tools only.</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <jenkins.model.BuildDiscarderProperty>
      <strategy class="hudson.tasks.LogRotator">
        <daysToKeep>-1</daysToKeep>
        <numToKeep>10</numToKeep>
        <artifactDaysToKeep>-1</artifactDaysToKeep>
        <artifactNumToKeep>10</artifactNumToKeep>
        <removeLastBuild>false</removeLastBuild>
      </strategy>
    </jenkins.model.BuildDiscarderProperty>
  </properties>
  <scm class="hudson.scm.NullSCM"/>
  <canRoam>true</canRoam>
  <disabled>false</disabled>
  <blockBuildWhenDownstreamBuilding>false</blockBuildWhenDownstreamBuilding>
  <blockBuildWhenUpstreamBuilding>false</blockBuildWhenUpstreamBuilding>
  <triggers/>
  <concurrentBuild>false</concurrentBuild>
  <builders>
    <hudson.tasks.Shell>
      <command>#!/bin/sh
set -eu
echo &apos;Hello, 05Shaibaan! Your independent Jenkins lab is running.&apos;
printf &apos;Job: %s | Run: #%s\n&apos; &quot;$JOB_NAME&quot; &quot;$BUILD_NUMBER&quot;
printf &apos;Build URL: %s\nWorkspace: %s\n&apos; &quot;$BUILD_URL&quot; &quot;$WORKSPACE&quot;
printf &apos;Ubuntu user: &apos;; whoami
date --iso-8601=seconds
</command>
      <configuredLocalRules/>
    </hudson.tasks.Shell>
  </builders>
  <publishers/>
  <buildWrappers/>
</project>